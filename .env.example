# - CORE -
DOMAIN=https://vaultwarden.<tailnet>.ts.net

# Generate at: tailscale.com/admin/settings/keys
# reusable key, tagged as tag:servers so it's marked as a server device
TS_AUTHKEY=tskey-auth-... 

# Generate with: 
#   docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
ADMIN_TOKEN='$argon2id$...'

# Set to false after creating your account
SIGNUPS_ALLOWED=true
# Set to true when not using admin panel
DISABLE_ADMIN_TOKEN=false

# - SMTP (2FA recovery codes, org invites) -
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURITY=force_tls
SMTP_USERNAME=user@domain.com
SMTP_PASSWORD=<smtp-app-password>
SMTP_FROM=user@domain.com
SMTP_FROM_NAME=Vaultwarden

# - Hardening (Limit login failures) -
LOGIN_RATELIMIT_MAX_BURST=5
LOGIN_RATELIMIT_SECONDS=120
ADMIN_RATELIMIT_MAX_BURST=5
ADMIN_RATELIMIT_SECONDS=300

# Disable user-facing registration of orgs
ORG_CREATION_USERS=none

# Sends (encrypted file/text sharing)
SENDS_ALLOWED=true

# Emergency access (trusted contact can request vault access)
EMERGENCY_ACCESS_ALLOWED=true

# Email change requires token confirmation
EMAIL_CHANGE_ALLOWED=true
